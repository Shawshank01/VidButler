{
  "name": "vidbutler",
  "version": "5.3.5",
  "description": "Video downloader and media processor using yt-dlp and FFmpeg with AI assistance",
  "main": "out/main.js",
  "type": "module",
  "scripts": {
    "test": "node --test test/",
    "prestart": "pnpm run compile:app && node out/check-dependencies.js",
    "start": "electron .",
    "lint": "eslint .",
    "typecheck": "tsc --project tsconfig.json",
    "compile:app": "node scripts/compile-app.mjs",
    "postinstall": "electron-builder install-app-deps",
    "prepare-tools": "node scripts/prepare-tools.mjs",
    "build": "pnpm prepare-tools && electron-builder --publish never",
    "build:mac": "pnpm prepare-tools && electron-builder build --mac --publish never",
    "build:win": "pnpm prepare-tools && electron-builder build --win --publish never",
    "build:win:arm64": "pnpm prepare-tools && electron-builder build --win --arm64 --publish never",
    "build:linux": "pnpm prepare-tools && electron-builder build --linux AppImage --publish never",
    "build:linux:x64": "pnpm prepare-tools && electron-builder build --linux AppImage --x64 --publish never",
    "build:linux:arm64": "pnpm prepare-tools && electron-builder build --linux AppImage --arm64 --publish never"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shawshank01/Vidbutler.git"
  },
  "keywords": [
    "youtube",
    "x(twitter)",
    "tiktok",
    "instagram",
    "facebook",
    "reddit",
    "bilibili",
    "video",
    "audio",
    "downloader",
    "yt-dlp",
    "ffmpeg",
    "electron"
  ],
  "author": {
    "name": "Michifumi",
    "email": "lelouch@outlook.ie"
  },
  "license": "GPL-2.0-only",
  "dependencies": {
    "electron-updater": "^6.8.12"
  },
  "bugs": {
    "url": "https://github.com/Shawshank01/Vidbutler/issues"
  },
  "homepage": "https://github.com/Shawshank01/Vidbutler#readme",
  "devDependencies": {
    "@electron/asar": "4.3.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "optionalDependencies": {
    "dmg-license": "^1.0.11"
  },
  "build": {
    "appId": "com.vidbutler.app",
    "productName": "VidButler",
    "compression": "maximum",
    "artifactName": "VidButler-${os}-${arch}-${version}.${ext}",
    "publish": {
      "provider": "github"
    },
    "beforePack": "./scripts/compile-app.mjs",
    "afterPack": "./scripts/prepare-mac-signing.mjs",
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false,
      "preAutoEntitlements": false,
      "timestamp": "none",
      "notarize": false,
      "signIgnore": [
        "/Contents/Resources/tools/"
      ],
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "appImage": {
      "compression": "zstd"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "build-tools/${os}-${arch}",
        "to": "tools"
      }
    ],
    "files": [
      "out/**/*",
      "build/icon.png",
      "tools-versions.json",
      "LICENSE",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ]
  }
}
