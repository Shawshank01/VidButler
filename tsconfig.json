{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleDetection": "legacy",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*"
  ]
}